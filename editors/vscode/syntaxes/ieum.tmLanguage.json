{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "이음",
  "scopeName": "source.ieum",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#quoted-name"
    },
    {
      "include": "#number"
    },
    {
      "include": "#function-header"
    },
    {
      "include": "#name"
    },
    {
      "include": "#flow"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#word-operator"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.ieum",
      "match": "#.*$"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.ieum",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.triple.raw.ieum",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.ieum",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.raw.ieum",
          "begin": "'",
          "end": "'|$"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.ieum",
      "match": "\\\\(?:[nrt\"'\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})|\\{\\{|\\}\\}"
    },
    "interpolation": {
      "name": "meta.interpolation.ieum",
      "begin": "\\{",
      "end": "\\}|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.ieum"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.ieum"
        }
      },
      "contentName": "meta.embedded.expression.ieum",
      "patterns": [
        {
          "include": "#group"
        },
        {
          "name": "string.other.format.ieum",
          "begin": ":",
          "end": "(?=\\}|$)"
        },
        {
          "include": "$self"
        }
      ]
    },
    "group": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}|$",
          "patterns": [
            {
              "include": "#group"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]|$",
          "patterns": [
            {
              "include": "#group"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\(",
          "end": "\\)|$",
          "patterns": [
            {
              "include": "#group"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "quoted-name": {
      "name": "variable.parameter.ieum",
      "match": "`[^`\\s]+`"
    },
    "number": {
      "name": "constant.numeric.ieum",
      "match": "(?<![\\p{L}\\p{N}_])(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)"
    },
    "constant": {
      "name": "constant.language.ieum",
      "match": "(?<![\\p{L}\\p{N}_])(?:참|거짓|없음)(?=(?:이면|이다|이고|이거나|인|이|을|은|과|으로|의|에|만큼)?(?![\\p{L}\\p{N}_]))"
    },
    "operator": {
      "name": "keyword.operator.ieum",
      "match": "\\*\\*|//|==|!=|<=|>=|[-+*/%<>]"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.ieum",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.block.ieum",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.ieum",
          "match": ","
        }
      ]
    },
    "function-header": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])([\\p{L}\\p{N}_]+)(?:을|를|이|가|에게|에서|에|으로|로|와|과|만큼)(?=\\s+[\\p{L}\\p{N}_]+\\s+법\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.function.ieum"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])([\\p{L}\\p{N}_]+)\\s+(법)\\s*(?=:)",
          "captures": {
            "1": {
              "name": "entity.name.function.ieum"
            },
            "2": {
              "name": "storage.type.function.ieum"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])([\\p{L}\\p{N}_]+지)\\s*(?=:\\s*(?:#.*)?$)",
          "captures": {
            "1": {
              "name": "entity.name.function.ieum"
            }
          }
        }
      ]
    },
    "flow": {
      "patterns": [
        {
          "name": "keyword.control.ieum",
          "match": "(?<![\\p{L}\\p{N}_])(?:그렇지\\s+않(?:으면|고)|반복을\\s+중단한다|다음으로\\s+진행한다|오류를\\s+다시\\s+발생시킨다)(?![\\p{L}\\p{N}_])"
        },
        {
          "match": "^\\s*(오류를)\\s+\\S+\\s+(받으면)(?=\\s*:)",
          "captures": {
            "1": {
              "name": "keyword.control.ieum"
            },
            "2": {
              "name": "keyword.control.ieum"
            }
          }
        },
        {
          "name": "keyword.control.ieum",
          "match": "^\\s*(?:오류|실행을)(?=\\s)"
        },
        {
          "name": "keyword.control.ieum",
          "match": "(?<![\\p{L}\\p{N}_])(?:반환한다|시도한다|마지막으로|발생시킨다|끝낸다|함께|병렬로|중|동안|내려가며)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.control.ieum",
          "match": "(?<![\\p{L}\\p{N}_])각각(?=(?:을|를|이|가|에게|에서|에|으로|로|와|과|만큼)?(?![\\p{L}\\p{N}_]))"
        },
        {
          "name": "keyword.control.ieum",
          "match": "(?<=, |,)아니면(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.control.ieum",
          "match": "(?<=[\\p{L}\\p{N}_)\\]`])마다(?=\\s*:)"
        },
        {
          "name": "keyword.control.ieum",
          "match": "(?<=[\\p{L}\\p{N}_)\\]`])(?:부터|까지)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "definition": {
      "patterns": [
        {
          "name": "storage.modifier.ieum",
          "match": "^\\s*상수(?=\\s)"
        },
        {
          "name": "storage.type.class.ieum",
          "match": "(?<![\\p{L}\\p{N}_])가진다(?=\\s*\\.)"
        },
        {
          "name": "keyword.other.ieum",
          "match": "(?<![\\p{L}\\p{N}_])(?:가져온다|바꾼다)(?=\\s*\\.)"
        },
        {
          "name": "keyword.other.ieum",
          "match": "(?<=만큼 )(?:늘린다|줄인다)(?=\\s*\\.)"
        },
        {
          "name": "keyword.other.ieum",
          "match": "(?<=\\()기본(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.ieum",
          "match": "(?<![\\p{L}\\p{N}_])(?:호출한다|호출하고|호출해서|호출하면|호출한(?:\\s+값)?)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.ieum",
          "match": "(?<=[\\p{L}\\p{N}_\\\"'`)\\]}])(?:이다|다)(?=\\s*\\.)"
        }
      ]
    },
    "builtin": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(파이썬)에서\\s+(가져오)(으면|면)(?![\\p{L}\\p{N}_])",
          "captures": {
            "1": {
              "name": "support.function.builtin.ieum"
            },
            "2": {
              "name": "support.function.builtin.ieum"
            },
            "3": {
              "name": "keyword.control.ieum"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(파이썬)에서\\s+((?:가져오거나|가져오고|가져온다|가져와서|가져온)(?:\\s+값)?)(?![\\p{L}\\p{N}_])",
          "captures": {
            "1": {
              "name": "support.function.builtin.ieum"
            },
            "2": {
              "name": "support.function.builtin.ieum"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(JSON변환하|JSON해석하|내림차순정렬하|CSV변환하|CSV해석하|대문자변환하|문자열변환하|소문자변환하|정규식치환하|현재시각구하|교집합구하|목록변환하|시각해석하|실수변환하|정수변환하|집합변환하|차집합구하|튜플변환하|합집합구하|반올림하|번호붙이|줄분리하|파일지우|폴더만들|결합하|기다리|내려받|내림하|덧붙이|복사하|분리하|비어있|시작하|실행하|연결하|올림하|일치하|정렬하|존재하|추가하|추출하|출력하|치환하|파일찾|포함되|폴더읽|확인하|끝나|다듬|뒤집|보내|옮기|지우|짝지|물|뽑|섞|세|쓰|없|읽|있|찾)(으면|면)(?![\\p{L}\\p{N}_])",
          "captures": {
            "1": {
              "name": "support.function.builtin.ieum"
            },
            "2": {
              "name": "keyword.control.ieum"
            }
          }
        },
        {
